# Copy to .env.local for development. None of these are required to run the
# site; each one switches on the feature it belongs to, and the contact form
# degrades honestly without them.

# Resend, for delivering the contact form to Owen's inbox.
# Without it the form tells the visitor to email directly instead.
# https://resend.com/api-keys
RESEND_API_KEY=

# Cloudflare Turnstile, the spam check in front of that send.
# https://dash.cloudflare.com/?to=/:account/turnstile
#
# The site key is public: it ships to the browser and only names the widget.
# The secret key is not, and it is what actually validates a token, so adding
# the secret is what switches enforcement on.
#
# With neither set, the form works and only the honeypot guards it.
# Cloudflare's always-passes test pair is below, handy for local work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
